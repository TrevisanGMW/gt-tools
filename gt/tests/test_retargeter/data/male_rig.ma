Eye.MaleSlimAth_LeftEye_Mesh\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_RightEye.MaleSlimAth_RightEye_Mesh\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_Teeth_Mesh.MaleSlimAth_Teeth_Mesh\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_Mesh.MaleSlimAth_Mesh\\\")\\n\\n# Mid Ath\\ncondition = core_node.create_node(node_type=\\\"condition\\\", name=\\\"midAth_condition\\\")\\ncmds.connectAttr(\\\"visibility_CTRL.bodyType\\\", f\\\"{condition}.firstTerm\\\")\\ncmds.setAttr(f\\\"{condition}.secondTerm\\\", 3)\\ncmds.setAttr(f\\\"{condition}.colorIfTrueR\\\", 1)\\ncmds.setAttr(f\\\"{condition}.colorIfFalseR\\\", 0)\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_Wb.MaleMidAth_Wb\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_LeftEye.MaleMidAth_LeftEye_Mesh\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_RightEye.MaleMidAth_RightEye_Mesh\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_Teeth_Mesh.MaleMidAth_Teeth_Mesh\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_Mesh.MaleMidAth_Mesh\\\")\\n\\n# Big\\ncondition = core_node.create_node(node_type=\\\"condition\\\", name=\\\"big_condition\\\")\\ncmds.connectAttr(\\\"visibility_CTRL.bodyType\\\", f\\\"{condition}.firstTerm\\\")\\ncmds.setAttr(f\\\"{condition}.secondTerm\\\", 4)\\ncmds.setAttr(f\\\"{condition}.colorIfTrueR\\\", 1)\\ncmds.setAttr(f\\\"{condition}.colorIfFalseR\\\", 0)\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_Wb.MaleBig_Wb\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_LeftEye.MaleBig_LeftEye_Mesh\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_RightEye.MaleBig_RightEye_Mesh\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_Teeth_Mesh.MaleBig_Teeth_Mesh\\\")\\ncmds.connectAttr(f\\\"{condition}.outColorR\\\", \\\"BS_MaleMid_Mesh.MaleBig_Me