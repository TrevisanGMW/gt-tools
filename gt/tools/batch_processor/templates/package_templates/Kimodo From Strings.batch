{
    "version": 1,
    "project_name": "Kimodo From Strings",
    "notes": "Generate animations from text without input files. Save this project to choose its output root. Each Input Strings row (or pasted line) is a complete JSON motion sequence of [seconds, description] pairs, for example [[2, \"A person starts to walk\"], [1, \"A person comes to a stop\"]]. Kimodo Definition uses Motion source: Text with {input-string}; edit durations in the input rows and set model, samples and variations in Kimodo Definition. Configure the Bridge connection in Kimodo Generate. Each nonblank row starts a new Maya scene and is exposed through {input-string} and {input-string-index}. Python tasks can read env['input-string']. String inputs skip scene capture and use prompt durations. Outputs are skipped when overwrite is off.",
    "environment_variables": {
        "project-dir": "{project-file-dir}",
        "input-dir": "01_input",
        "task-dir": "02_tasks",
        "output-dir": "03_output"
    },
    "run_settings": {
        "multi_instance": true,
        "worker_count": 2,
        "max_retries": 1,
        "timeout_minutes": 0,
        "create_log": true,
        "create_task_time_log": true,
        "log_path": "logs"
    },
    "tasks": [
        {
            "id": "a87503ea-3df4-44e0-9c1b-b51c39fa5b31",
            "task_type": "input_strings",
            "display_name": "Input Motion Prompts",
            "enabled": true,
            "parameters": {
                "strings": [
                    "[[2, \"A person starts to walk forward at a relaxed pace.\"], [1, \"A person comes to a stop.\"]]",
                    "[[4, \"A person waves hello with their right hand.\"]]",
                    "[[2, \"A person jumps in place and lands on both feet.\"], [1, \"A person stands still.\"]]"
                ]
            }
        },
        {
            "id": "b1e344bd-e897-4ce3-b2cd-e60485c3bff2",
            "task_type": "kimodo_definition",
            "display_name": "Kimodo Definition From Text",
            "enabled": true,
            "parameters": {
                "source_mode": "incoming",
                "target_path": "{project-dir}/{task-dir}/kimodo_definitions",
                "prompt_mode": "text",
                "prompt_text": "{input-string}",
                "duration_mode": "definition",
                "capture_first": false,
                "capture_last": false,
                "use_marker": false,
                "overwrite": false
            }
        },
        {
            "id": "d7f0f4e8-faad-4a68-a773-42e86d28c762",
            "task_type": "kimodo_generate",
            "display_name": "Kimodo Generate",
            "enabled": true,
            "parameters": {
                "source_mode": "incoming",
                "target_path": "{project-dir}/{output-dir}/kimodo",
                "result_mode": "maya",
                "add_humanik": true,
                "overwrite": false
            }
        }
    ]
}
