# Relative bind mounts keep this deployment movable as one directory.
# prepare_deployment() assigns a unique project name; keep that generated name.
COMPOSE_PROJECT_NAME=kimodo-bridge
KIMODO_IMAGE=kimodo-bridge:1.12.0
BASE_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
BRIDGE_BIND_ADDRESS=127.0.0.1
BRIDGE_PORT=7861
BRIDGE_DEVICE=cuda
ENCODER_DEVICE=cuda
# LAN deployment: choose a host interface (or 0.0.0.0) and set this to false.
ALLOW_REMOTE_SHUTDOWN=true
